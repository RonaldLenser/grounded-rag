# Copy to .env and fill in real values. .env is gitignored.
# Settings are added to src/grounded/config.py as milestones start using them.

# ----- App -----
# One of: local | test | prod  (local = colored logs, others = JSON logs)
APP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ----- Database -----
# Matches the `db` service in docker-compose.yml, exposed on host port 5433
# (start it: docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5433/grounded
DB_POOL_SIZE=5
DB_ECHO=false

# ----- Providers (M2+) -----
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
LLM_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-haiku-5-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ----- RAG tuning (M2+) -----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=6
# One of: vector | hybrid
RETRIEVAL_STRATEGY=vector
# Calibrated by evals in M7
MIN_RELEVANCE_SCORE=0.20
MAX_CONTEXT_TOKENS=6000

# ----- Security / limits -----
ADMIN_API_KEY=generate-a-long-random-string
MAX_UPLOAD_MB=10
RATE_LIMIT_QUERY=10/minute
CORS_ORIGINS=http://localhost:8000
