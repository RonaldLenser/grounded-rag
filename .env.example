# Copy to .env and fill in real values. .env is gitignored.
# Variables marked (M1+) are read starting in that milestone.

# --- App ---
APP_ENV=local                 # local | test | prod
LOG_LEVEL=INFO

# --- Database (M1+) ---
DATABASE_URL=postgresql+asyncpg://grounded:grounded@localhost:5432/grounded

# --- Providers (M2+) ---
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
LLM_MODEL=claude-sonnet-model-id
JUDGE_MODEL=small-model-id-for-evals
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- RAG tuning (M2+) ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=6
RETRIEVAL_STRATEGY=vector     # vector | hybrid
MIN_RELEVANCE_SCORE=0.30      # calibrated by evals in M7
MAX_CONTEXT_TOKENS=6000

# --- Security / limits ---
ADMIN_API_KEY=generate-a-long-random-string
MAX_UPLOAD_MB=10
RATE_LIMIT_QUERY=10/minute
CORS_ORIGINS=http://localhost:8000
